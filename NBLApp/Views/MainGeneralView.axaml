<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:NBLApp.Localization"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="550"
             x:Class="NBLApp.Views.MainGeneralView">

	<Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">

		<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
			<StackPanel Spacing="3">
				<TextBlock Text="{loc:Translate ServerMonitorTitle}" FontSize="24" FontWeight="Bold"/>
				<TextBlock Text="{loc:Translate ServerMonitorDescription}" Opacity="0.65"/>
			</StackPanel>
			<TextBlock x:Name="RefreshInfo" Grid.Column="1" Text="{loc:Translate ServerMonitorLoading}" VerticalAlignment="Center" Opacity="0.6"/>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" Margin="0,0,0,14">
			<Border Background="#55000000" CornerRadius="6" Padding="12">
				<StackPanel Spacing="4">
					<TextBlock Text="{loc:Translate ServerCount}" Opacity="0.7"/>
					<TextBlock x:Name="ServerCount" Text="0" FontSize="22" FontWeight="Bold"/>
				</StackPanel>
			</Border>
			<Border Grid.Column="1" Background="#55000000" CornerRadius="6" Padding="12">
				<StackPanel Spacing="4">
					<TextBlock Text="{loc:Translate PlayerCount}" Opacity="0.7"/>
					<TextBlock x:Name="PlayerCount" Text="0" FontSize="22" FontWeight="Bold"/>
				</StackPanel>
			</Border>
			<Border Grid.Column="2" Background="#55000000" CornerRadius="6" Padding="12">
				<StackPanel Spacing="4">
					<TextBlock Text="{loc:Translate PopulatedCount}" Opacity="0.7"/>
					<TextBlock x:Name="PopulatedCount" Text="0" FontSize="22" FontWeight="Bold"/>
				</StackPanel>
			</Border>
			<Border Grid.Column="3" Background="#55000000" CornerRadius="6" Padding="12">
				<StackPanel Spacing="4">
					<TextBlock Text="{loc:Translate FreeSlots}" Opacity="0.7"/>
					<TextBlock x:Name="FreeSlots" Text="—" FontSize="22" FontWeight="Bold"/>
				</StackPanel>
			</Border>
		</Grid>

		<Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
			<TextBox x:Name="SearchBox"
                     Watermark="{loc:Translate ServerSearchPlaceholder}"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_OnTextChanged"/>

			<ComboBox x:Name="ClientFilter"
                      Grid.Column="1"
                      Width="170"
                      SelectedIndex="0"
                      SelectionChanged="ClientFilter_OnSelectionChanged">
				<ComboBoxItem Content="{loc:Translate ServerFilterAllClients}" Tag="*"/>
			</ComboBox>
		</Grid>

		<Grid Grid.Row="3" RowDefinitions="Auto,*">
			<Border Background="#88000000" Padding="10">
				<Grid ColumnDefinitions="3*,2*,1.2*,1.2*,1.2*" ColumnSpacing="8">
					<TextBlock Text="{loc:Translate ServerColumnName}" FontWeight="Bold"/>
					<TextBlock Grid.Column="1" Text="{loc:Translate ServerColumnMap}" FontWeight="Bold"/>
					<TextBlock Grid.Column="2" Text="{loc:Translate ServerColumnMode}" FontWeight="Bold"/>
					<TextBlock Grid.Column="3" Text="{loc:Translate ServerColumnPlayers}" FontWeight="Bold"/>
					<TextBlock Grid.Column="4" Text="{loc:Translate ServerColumnPing}" FontWeight="Bold"/>
				</Grid>
			</Border>

			<Grid Grid.Row="1">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel x:Name="ServerList" Spacing="2"/>
				</ScrollViewer>

				<TextBlock x:Name="EmptyState"
                           Text="{loc:Translate ServerMonitorEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.55"/>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
