<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:NBLApp.Controls"
             xmlns:loc="clr-namespace:NBLApp.Localization"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="650"
             Background="Transparent"
             x:Name="SimpInstControl"
             x:Class="NBLApp.Forms.SimpInst">

	<c:Form Title="{loc:Translate InstallGameTitle}" Width="600">
		<c:Form.Content>
			<StackPanel Spacing="12">
				<TextBlock Name="TextBlockPath"
                           Text="{loc:Translate GamePath}"
                           Foreground="#B1B1B1"/>

				<u:PathPicker Name="PathPickerGamePath"
                              Title="OVERVIEW"
                              UsePickerType="OpenFolder"/>

				<TextBlock Name="TextBlockError"
                           Foreground="#f54e4e"
                           IsVisible="False"
                           TextWrapping="Wrap"/>

				<StackPanel Name="PanelProgress" Spacing="8" IsVisible="False">
					<TextBlock Name="TextBlockStatus"
                               Text="{loc:Translate Status}"
                               Foreground="#B1B1B1"/>

					<TextBlock Name="TextBlockSpeed"
                               Text="{loc:Translate InstallSpeed}"
                               Foreground="#B1B1B1"/>

					<TextBlock Name="TextBlockEta"
                               Text="{loc:Translate InstallRemaining}"
                               Foreground="#B1B1B1"/>

					<TextBlock Name="TextBlockOverall"
                               Text="{loc:Translate InstallOverallProgress}"
                               Foreground="#B1B1B1"/>

					<TextBlock Name="TextBlockDownloads"
                               Foreground="#B1B1B1"
                               TextWrapping="Wrap"/>

					<ProgressBar Name="ProgressBarOverall"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>
				</StackPanel>
			</StackPanel>
		</c:Form.Content>

		<c:Form.ActionContent>
			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
				<Button Name="ButtonCancel"
                        Click="ButtonCancel_OnClick"
                        Content="{loc:Translate Cancel}"/>

				<Button Name="ButtonSave"
                        Click="ButtonSave_OnClick"
                        Content="{loc:Translate Install}"
                        Classes="Primary"
                        Theme="{StaticResource SolidButton}"/>
			</StackPanel>
		</c:Form.ActionContent>
	</c:Form>
</UserControl>
